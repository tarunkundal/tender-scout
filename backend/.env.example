# Copy to backend/.env (git-ignored) and adjust. Empty values (KEY=) fall back to the defaults.

# --- App ---
ENVIRONMENT=local
APP_NAME=TenderScout
API_PREFIX=
# Leave empty locally (a dev placeholder is used and a warning is logged).
# Required in production; generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
LOG_LEVEL=INFO
# JSON list or comma-separated
CORS_ORIGINS=http://localhost:5173

# --- Database (local Docker: `make up`) ---
# Plain postgres:// or postgresql:// URLs are accepted and converted to postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://tenderscout:tenderscout@localhost:5432/tenderscout
# Empty = same as DATABASE_URL
DATABASE_URL_DIRECT=
DB_DISABLE_PREPARED_STATEMENTS=false
DB_POOL_SIZE=5
DB_POOL_RECYCLE_SECONDS=300

# --- Neon example (replace the local values above) ---
# Pooled URL (host has "-pooler"): used by the API and Celery workers.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct URL (no "-pooler"): used by Alembic migrations and the LangGraph checkpointer.
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# The pooled URL goes through PgBouncer, so asyncpg's prepared-statement caches must be off.
# DB_DISABLE_PREPARED_STATEMENTS=true

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# Empty = same as REDIS_URL
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- AI (placeholders, used from Task 6) ---
LLM_SMALL_MODEL=
LLM_STRONG_MODEL=
EMBEDDING_MODEL=
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
