# Backend base URL as seen by the browser. "/api" goes through the Vite dev
# proxy (vite.config.ts) to http://localhost:8000 with the "/api" prefix removed.
VITE_API_BASE_URL=/api
# Neon Auth URL of your Neon branch (Console → Auth → Configuration).
# Each branch has its own URL and users. Use the same value as NEON_AUTH_URL in backend/.env.
VITE_NEON_AUTH_URL=https://ep-example-123456.neonauth.c-0.us-east-2.aws.neon.tech/neondb/auth
